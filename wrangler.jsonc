{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relampago-courier",
  "compatibility_date": "2026-09-15",
  // SPA estática: Vite compila a ./dist y Cloudflare sirve los assets.
  // Cualquier ruta que no sea un archivo cae en index.html (React Router).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
